<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnNotificationAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Notifications"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnInstallAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow Icon Pack Installation"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Step 1: Scan Apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/step1Indicator"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/step_circle_inactive"
                android:gravity="center"
                android:text="1"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan Apps"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/step1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not started"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2: Generate Resources -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/step2Indicator"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/step_circle_inactive"
                android:gravity="center"
                android:text="2"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generate Resources"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/step2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not started"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 3: Build APK on Host -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/step3Indicator"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/step_circle_inactive"
                android:gravity="center"
                android:text="3"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Build APK on Device"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/step3Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not started"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 4: Install -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/step4Indicator"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/step_circle_inactive"
                android:gravity="center"
                android:text="4"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Install"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/step4Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not started"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#888888"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switchAutoUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-update icon pack on app installs and updates"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate and Install Icon Pack"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStopGeneration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop All Generation"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnInstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Install Icon Pack"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectInLauncher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select in Launcher Settings"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#AAAAAA" />

    </LinearLayout>
</ScrollView>
